# The CI gate, runnable anywhere (`bun run test:docker`): formatting, the
# dependency audit, type-check (svelte-check + tsc), unit/integration tests
# (Vitest, including real Pyodide with the real pinned wheels — fetched and
# hash-verified at image build time; no wheels live in the repo — real
# ffmpeg.wasm, the real remux core and real workerd), and the Playwright e2e
# suite on Chromium, Firefox and WebKit, whose merge journey runs a second
# time with the remux core, and whose no-relay journey runs on a build
# without a relay (VITE_RELAY_URL=none).

# The remux core (`bun run build:ffmpeg`): FFmpeg compiled to WebAssembly in
# the image of the Emscripten release scripts/build-ffmpeg.ts pins, so the
# script finds that emcc on PATH. Its own stage: only its sources invalidate it.
FROM emscripten/emsdk:6.0.10 AS remux-core
COPY --from=oven/bun:1.4.4 /usr/local/bin/bun /usr/local/bin/bun
WORKDIR /app
COPY ffmpeg ffmpeg/
COPY scripts/build-ffmpeg.ts scripts/
RUN bun scripts/build-ffmpeg.ts

# The base image version MUST match the @playwright/test version in bun.lock —
# the image ships the exact browser builds that library version expects, so no
# `playwright install` is needed.
FROM mcr.microsoft.com/playwright:v1.64.1-noble

# Bun drives installs and package scripts; the Vitest/Playwright binaries still
# execute under the image's Node runtime via their shebangs.
COPY --from=oven/bun:1.4.4 /usr/local/bin/bun /usr/local/bin/bun

WORKDIR /app

# Dependency layer first so source-only changes don't re-run bun install.
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile

# Fetch the pinned yt-dlp wheels for the integration and e2e tests (own layer,
# so source changes don't re-download them). The script verifies every SHA-256.
COPY src/lib/engine/wheels.ts src/lib/engine/
COPY scripts/fetch-wheels.ts scripts/
RUN bun scripts/fetch-wheels.ts

COPY --from=remux-core /app/.ffmpeg-build/dist .ffmpeg-build/dist
COPY . .

ENV CI=1
ENV E2E_BROWSERS=chromium,firefox,webkit

# The e2e webServer builds the app and serves it on :4173 internally, so this
# needs no network beyond what the tests stub. Run with --ipc=host: Chromium can
# exhaust a container's default /dev/shm. Playwright empties its output
# directory when it starts, so each later run writes to its own: the earlier
# runs' traces of failed attempts survive for CI to upload.
CMD ["bash", "-c", "bun run format:check && bun run audit && bun run check && bun run test && bun run test:e2e && YT_DLP_WEB_FFMPEG=remux bun run test:e2e tests/e2e/merge.test.ts --output test-results/remux && VITE_RELAY_URL=none bun run test:e2e tests/e2e/no-relay.test.ts --output test-results/no-relay"]
