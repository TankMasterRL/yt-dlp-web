{
	"compilerOptions": {
		"target": "esnext",
		"lib": ["esnext", "dom"],
		"module": "esnext",
		"moduleResolution": "bundler",
		"types": ["bun"],
		"strict": true,
		"skipLibCheck": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"isolatedModules": true,
		// csp.config.js is plain JS (svelte.config.js imports it); its JSDoc types it.
		"allowJs": true,
		"checkJs": true
	},
	"include": ["*.ts"]
}
