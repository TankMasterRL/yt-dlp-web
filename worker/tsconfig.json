{
	"compilerOptions": {
		"target": "es2023",
		"lib": ["es2023"],
		"module": "esnext",
		"moduleResolution": "bundler",
		"types": ["@cloudflare/workers-types"],
		"strict": true,
		"skipLibCheck": true,
		"noEmit": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": true
	},
	"include": ["src/**/*.ts", "../src/lib/relay/protocol.ts"],
	"exclude": ["src/**/*.test.ts"]
}
