{
	"$schema": "../node_modules/wrangler/config-schema.json",
	"name": "yt-dlp-web",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-01",
	"observability": { "enabled": true },
	"vars": {
		// Origins (besides this Worker's own) whose pages may use the relay. Set this
		// to wherever the app is hosted; for local development put
		// ALLOWED_ORIGINS="http://localhost:5173,http://localhost:4173" in .dev.vars.
		"ALLOWED_ORIGINS": "https://tankmasterrl.github.io"
		// ALLOWED_HOSTS defaults to the hosts YouTube extraction needs (src/config.ts).
		// Widen it deliberately, host by host — never to a bare wildcard.
	},
	// Per-client-IP request budget. One extraction is ~5–10 requests; a 1 GB
	// download in 10 MB chunks is ~100.
	"ratelimits": [
		{ "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 600, "period": 60 } }
	]
	// All-in-one deploy — this Worker also serves the app from one origin, with full
	// security headers and no CORS. Build the app WITHOUT VITE_RELAY_URL, then:
	// "assets": { "directory": "../build", "binding": "ASSETS", "run_worker_first": ["/relay"] }
}
